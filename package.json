{
  "name": "kame-layout",
  "private": true,
  "type": "module",
  "description": "Scrapbox / Cosense custom styles and scripts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/generate.mjs",
    "check": "node tools/generate.mjs --check && node tools/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tools/browser-check.mjs",
    "format": "prettier --write 'src/features/**/*.js' 'src/theme/*.css' 'tools/*.mjs' 'tests/*.mjs' config/features.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "acorn": "^8.19.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1"
  }
}
